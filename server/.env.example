PORT=5000
# Required: paste the Atlas connection URI locally; never commit server/.env.
MONGODB_URI=
# Required: at least 32 characters (generate with crypto.randomBytes).
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Exact comma-separated frontend origins; add the Vercel production origin on Render.
CLIENT_URL=http://localhost:5173
# Server-only key. Leave empty to use scripted scenarios and fallback explanations.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# true disables Gemini for a repeatable judging demo; MongoDB is still required.
DEMO_MODE=false
NODE_ENV=development
